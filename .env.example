# WATCHDOG Environment Configuration

# Application Environment & Mode
APP_ENV=development
EXECUTION_MODE=DEMO # Set to LIVE for real external API calls, or DEMO for deterministic hackathon testing

# Anakin API Credentials (First-Class Integration)
ANAKIN_API_KEY=your_anakin_api_key_here
ANAKIN_WEBHOOK_SECRET=watchdog_secret_key_123

# LLM API Settings
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-3.6-flash

# Database Connection
DATABASE_URL=sqlite:///./watchdog.db

# Optional Fallback Providers
JINA_API_KEY=
FIRECRAWL_API_KEY=
